{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artdaci.com/schema/semantic-experience-links.schema.json",
  "title": "ARTDACI Semantic Experience Links",
  "type": "object",
  "required": [
    "schemaVersion",
    "channels",
    "nodes"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string"
    },
    "channels": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "nodeId",
          "experiences"
        ],
        "properties": {
          "nodeId": {
            "type": "string",
            "minLength": 1
          },
          "experiences": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "channel",
                "href",
                "labels",
                "descriptions"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "channel": {
                  "type": "string"
                },
                "href": {
                  "type": "string",
                  "minLength": 1
                },
                "external": {
                  "type": "boolean"
                },
                "labels": {
                  "$ref": "#/$defs/i18n"
                },
                "descriptions": {
                  "$ref": "#/$defs/i18n"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "i18n": {
      "type": "object",
      "required": [
        "fr",
        "en",
        "ar"
      ],
      "properties": {
        "fr": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        },
        "ar": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
