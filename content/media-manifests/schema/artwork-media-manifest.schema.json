{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artdaci.com/schemas/artwork-media-manifest-2.0.json",
  "title": "ARTDACI artwork media manifest",
  "description": "Canonical description of artwork and shared media resolved through Cloudflare R2.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "slug",
    "defaultLanguage",
    "artist",
    "artwork",
    "pageUrl",
    "mediaBaseUrl",
    "sharedMediaBaseUrl",
    "cachePolicy",
    "media",
    "updatedAt"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "2.0" },
    "id": { "type": "string", "pattern": "^(ld|ve|vg|mo)0[1-8]$" },
    "slug": { "$ref": "#/$defs/slug" },
    "defaultLanguage": { "$ref": "#/$defs/language" },
    "artist": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "enum": ["ld", "ve", "vg", "mo"] },
        "name": { "$ref": "#/$defs/localizedText" }
      }
    },
    "artwork": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title"],
      "properties": {
        "title": { "$ref": "#/$defs/localizedText" },
        "date": { "type": "string" },
        "museum": { "type": "string" },
        "location": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "city": { "type": "string" },
            "country": { "type": "string" }
          }
        }
      }
    },
    "pageUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://artdaci\\.com/"
    },
    "mediaBaseUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://media\\.artdaci\\.com/artworks/(ld|ve|vg|mo)0[1-8]/$"
    },
    "sharedMediaBaseUrl": {
      "const": "https://media.artdaci.com/shared/"
    },
    "cachePolicy": { "const": "no-store" },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": ["images", "audio", "videos", "models", "ar"],
      "properties": {
        "images": { "$ref": "#/$defs/mediaFamily" },
        "audio": { "$ref": "#/$defs/mediaFamily" },
        "videos": { "$ref": "#/$defs/mediaFamily" },
        "models": { "$ref": "#/$defs/mediaFamily" },
        "ar": { "$ref": "#/$defs/mediaFamily" }
      }
    },
    "updatedAt": { "type": "string", "format": "date" }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(?:-[a-z0-9]{2,8})*$"
    },
    "localizedText": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/language" },
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "mediaFamily": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/slug" },
      "additionalProperties": { "$ref": "#/$defs/mediaNode" }
    },
    "mediaNode": {
      "oneOf": [
        { "$ref": "#/$defs/mediaAsset" },
        {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/slug" },
          "additionalProperties": { "$ref": "#/$defs/mediaNode" }
        }
      ]
    },
    "mediaAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "path", "mimeType", "available", "migrationStatus"],
      "properties": {
        "scope": { "type": "string", "enum": ["artwork", "shared"] },
        "path": {
          "type": "string",
          "minLength": 3,
          "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))[a-z0-9][a-z0-9./-]*[a-z0-9]$"
        },
        "mimeType": { "type": "string", "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$" },
        "available": { "type": "boolean" },
        "migrationStatus": {
          "type": "string",
          "enum": ["planned", "published", "quarantined-unused", "quarantined-duplicate"]
        },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "language": { "$ref": "#/$defs/language" }
      },
      "allOf": [
        {
          "if": { "properties": { "available": { "const": true } }, "required": ["available"] },
          "then": { "properties": { "migrationStatus": { "const": "published" } } }
        },
        {
          "if": {
            "properties": {
              "migrationStatus": { "enum": ["quarantined-unused", "quarantined-duplicate"] }
            },
            "required": ["migrationStatus"]
          },
          "then": { "properties": { "available": { "const": false } } }
        }
      ]
    }
  }
}
